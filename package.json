{
  "name": "agent-skills",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "lint:text": "textlint --config .textlintrc.json \"**/*.md\"",
    "plugin:new": "node scripts/new-plugin.ts",
    "plugin:version": "node scripts/version-plugin.ts",
    "plugin:check": "node scripts/version-plugin.ts --check",
    "plugin:release": "node scripts/publish-releases.ts",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "textlint": "15.8.0",
    "textlint-rule-ja-no-redundant-expression": "4.0.1"
  }
}
