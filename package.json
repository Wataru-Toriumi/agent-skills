{
  "name": "agent-skills",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "lint:code": "biome check --error-on-warnings",
    "fix:code": "biome check --write --error-on-warnings",
    "lint:text": "textlint --config .textlintrc.json \"**/*.md\"",
    "plugin:new": "node scripts/new-plugin.ts",
    "plugin:version": "node scripts/version-plugin.ts",
    "plugin:check": "node scripts/check-plugins.ts",
    "plugin:release": "node scripts/publish-releases.ts",
    "test": "node --test tests/*.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "mdast-util-from-markdown": "2.0.2",
    "textlint": "15.8.0",
    "textlint-rule-ja-no-redundant-expression": "4.0.1",
    "yaml": "2.8.1"
  }
}
